
# Generated by FastPlaz

RewriteEngine On
AddHandler cgi-script .cgi
AddHandler cgi-script .bin
AddHandler cgi-script .pas
AddHandler cgi-script .exe
Options +ExecCGI

DirectoryIndex forumpascal.bin
ErrorDocument 500 '{"code": 500}'
ErrorDocument 404 '{"code": 404}'
Header set X-Frame-Options SAMEORIGIN

SetEnvIf Token "(.*)" Token=$1

# canonical host: https://pascal-dev.org (tanpa www)
# www -> apex
RewriteCond %{HTTP_HOST} ^www\.pascal-dev\.org$ [NC]
RewriteRule ^(.*)$ https://pascal-dev.org/$1 [R=301,L]
# http -> https (di belakang Cloudflare: cek X-Forwarded-Proto)
RewriteCond %{HTTP_HOST} ^pascal-dev\.org$ [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^(.*)$ https://pascal-dev.org/$1 [R=301,L]
# http -> https (akses langsung tanpa proxy)
RewriteCond %{HTTP_HOST} ^pascal-dev\.org$ [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} ^$
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://pascal-dev.org/$1 [R=301,L]

#RewriteRule ^(search)/(.*)$ search.bin/$2 [QSA,L]
#RewriteRule ^(user)/(.*)/$ auth.bin/$2/ [QSA,L]
#RewriteRule ^(auth)/(.*)$ auth.bin/$2 [QSA,L]

# Tiga aturan ini hanya berlaku jika <nama>.bin benar-benar ada (search.bin,
# auth.bin). Selain itu (/forum/, /news/, /thread/...) jatuh ke forumpascal.bin.
# Tanpa syarat -f, putaran rewrite kedua mengubah "forumpascal.bin/news/" menjadi
# "forumpascal.bin.bin/news" dan route '/forum' ikut cocok (halaman salah).
RewriteCond %{DOCUMENT_ROOT}/$1.bin -f
RewriteRule ^(.*)/(.*)/(.*)/$ $1.bin/$2/$3 [QSA,L]
RewriteCond %{DOCUMENT_ROOT}/$1.bin -f
RewriteRule ^(.*)/(.*)/$ $1.bin/$2 [QSA,L]
RewriteCond %{DOCUMENT_ROOT}/$1.bin -f
RewriteRule ^(.*)/$ $1.bin [QSA,L]

<Files ~ "\.(tpl|txt)$">
  Order deny,allow
  Deny from all
  SetEnvIfNoCase User-Agent "Googlebot" goodbot
  Allow from env=goodbot
</Files>

# robots.txt must be readable by every crawler
<Files "robots.txt">
  Order allow,deny
  Allow from all
</Files>

RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -l
RewriteRule ^(.*)$ - [NC,L]
RewriteRule ^(.*)$ forumpascal.bin/$1 [QSA,L]
